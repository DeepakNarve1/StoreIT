generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["driverAdapters"]
}

datasource db {
  provider = "postgresql"
}

// ─── TENANT (Organisation) ───────────────────────────────────────────────────
model Tenant {
  id           String     @id @default(uuid())
  name         String
  slug         String     @unique  // used in URLs e.g. acme.yourdomain.com
  plan         String     @default("free") // free | starter | pro | enterprise
  isActive     Boolean    @default(true)
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
  

  users        User[]
  folders      Folder[]
  files        File[]
  categories   Category[]
  departments Department[]
  invites      InviteToken[]
  oneTimeLinks OneTimeLink[]
  auditLogs    AuditLog[]
  tags    Tag[] 
  stripeCustomerId     String?   // ← add
  stripeSubscriptionId String?   // ← add
  guestAccesses        GuestAccess[]
  metadataTemplates    MetadataTemplate[]
  metadataFolderFields FolderMetadataField[]
}

// ─── USER ────────────────────────────────────────────────────────────────────
model User {
  id           String    @id @default(uuid())
  email        String    @unique
  name         String
  password     String    // bcrypt hashed
  role         Role      @default(VIEWER)
  departmentId String?  
  department     Department? @relation("UserDepartment", fields: [departmentId], references: [id])
  isActive     Boolean   @default(true)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  tenantId     String
  tenant       Tenant    @relation(fields: [tenantId], references: [id])

  lockedFiles  File[]    @relation("LockedBy")
  approvedFiles   File[]   @relation("ApprovedBy")

  comments FileComment[]
  permissions  Permission[]
  invites      InviteToken[]
  uploadedFiles File[]   @relation("UploadedBy")
  uploadedVersions FileVersion[] @relation("VersionUploadedBy")
  auditLogs    AuditLog[]
  preferences  UserPreference[]

  @@index([tenantId])
  @@index([email])
}

model UserPreference {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  tenantId  String
  key       String
  value     Json
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, key])
  @@index([tenantId, userId])
  @@map("user_preferences")
}

model Department {
  id        String   @id @default(uuid())
  name      String
  tenantId  String
  tenant    Tenant   @relation(fields: [tenantId], references: [id])
  createdAt DateTime @default(now())
  users     User[]   @relation("UserDepartment")
  permissions Permission[]

  @@unique([name, tenantId])
  @@index([tenantId])
}

// ─── ROLE ENUM ───────────────────────────────────────────────────────────────
enum Role {
  SUPERADMIN
  ORG_ADMIN
  MANAGER
  EDITOR
  VIEWER
}

// ─── CATEGORY (sidebar categories like StoreIT) ─────────────────────────────
model Category {
  id           String     @id @default(uuid())
  name         String
  parentId     String?    // subcategory support
  parent       Category?  @relation("CategoryTree", fields: [parentId], references: [id])
  children     Category[] @relation("CategoryTree")
  tenantId     String
  tenant       Tenant     @relation(fields: [tenantId], references: [id])
  createdAt    DateTime   @default(now())

  folders      Folder[]
  files        File[]

  @@index([tenantId])
}

// ─── FOLDER ──────────────────────────────────────────────────────────────────
model Folder {
  id           String    @id @default(uuid())
  name         String
  path         String?   // materialised path e.g. /uuid1/uuid2/uuid3 — for fast tree queries
  isDeleted    Boolean   @default(false)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  tenantId     String
  tenant       Tenant    @relation(fields: [tenantId], references: [id])

  parentId     String?
  parent       Folder?   @relation("FolderTree", fields: [parentId], references: [id])
  children     Folder[]  @relation("FolderTree")

  categoryId   String?
  category     Category? @relation(fields: [categoryId], references: [id])

  isStarred    Boolean   @default(false)  

  files        File[]
  permissions  Permission[]
  metadataFields FolderMetadataField[]

  @@index([tenantId])
  @@index([tenantId, parentId])
  @@index([tenantId, categoryId])
}

// ─── FILE ────────────────────────────────────────────────────────────────────
model File {
  id           String    @id @default(uuid())
  name         String
  storageKey   String    // S3/R2 key: {tenantId}/{folderId}/{uuid}_{filename}
  mimeType     String
  size         Int       // bytes
  version      Int       @default(1)
  versions     FileVersion[] 
  isDeleted    Boolean   @default(false)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  tenantId     String
  tenant       Tenant    @relation(fields: [tenantId], references: [id])

  folderId     String?
  folder       Folder?   @relation(fields: [folderId], references: [id])

  categoryId   String?
  category     Category? @relation(fields: [categoryId], references: [id])

  isStarred    Boolean   @default(false)  
  tags         FileTag[]         

  isLocked     Boolean   @default(false)
lockedById   String?
lockedBy     User?     @relation("LockedBy", fields: [lockedById], references: [id])
lockedAt     DateTime?

  approvalStatus  String?  // null | pending | approved | rejected
approvalNote    String?  // reviewer's note
approvedById    String?
approvedBy      User?    @relation("ApprovedBy", fields: [approvedById], references: [id])
approvedAt      DateTime?  

  uploadedById String?
  uploadedBy   User?     @relation("UploadedBy", fields: [uploadedById], references: [id])

comments FileComment[]
  permissions  Permission[]
  metadata     FileMetadata[]
  oneTimeLinks OneTimeLink[]
  guestFiles   GuestAccess[]  @relation("GuestAccessFile")

  @@index([tenantId])
  @@index([tenantId, folderId])
  @@index([tenantId, categoryId])
}

// ─── FILE VERSION ─────────────────────────────────────────────────────────────
model FileVersion {
  id         String   @id @default(uuid())
  version    Int
  storageKey String
  size       Int
  createdAt  DateTime @default(now())

  fileId     String
  file       File     @relation(fields: [fileId], references: [id])

  uploadedById String?
  uploadedBy   User?   @relation("VersionUploadedBy", fields: [uploadedById], references: [id])

  @@index([fileId])
}

// ─── TAG ──────────────────────────────────────────────────────────────────────
model Tag {
  id        String    @id @default(uuid())
  name      String
  color     String    @default("#3B8BD4")
  tenantId  String
  tenant    Tenant    @relation(fields: [tenantId], references: [id])
  createdAt DateTime  @default(now())
  files     FileTag[]

  @@unique([name, tenantId])
  @@index([tenantId])
}

// ─── FILE TAG (junction) ──────────────────────────────────────────────────────
model FileTag {
  fileId String
  file   File   @relation(fields: [fileId], references: [id])
  tagId  String
  tag    Tag    @relation(fields: [tagId], references: [id])

  @@id([fileId, tagId])
}

// ─── PERMISSION ──────────────────────────────────────────────────────────────
model Permission {
  id             String    @id @default(uuid())
  action         String    // read | write | delete | admin  (coarse level — derived)
  capabilities   Json?     // granular keys: { "see_files": true, "delete_folders": true, ... }
  resourceType   String    // file | folder
  resourceId     String    // fileId or folderId
  grantedTo      String    // all | user | department
  expiresAt      DateTime? // auto-expiry support
  createdAt      DateTime  @default(now())

  // optional link to a specific user (if grantedTo = user)
  userId         String?
  user           User?     @relation(fields: [userId], references: [id])

  // optional link to a department (if grantedTo = department)
  departmentId   String?
  department     Department? @relation(fields: [departmentId], references: [id])

  // optional link to folder or file directly
  folderId       String?
  folder         Folder?   @relation(fields: [folderId], references: [id])
  fileId         String?
  file           File?     @relation(fields: [fileId], references: [id])

  @@index([resourceId, resourceType])
  @@index([userId])
  @@index([departmentId])
}

// ─── INVITE TOKEN (email invite system — no self-registration) ───────────────
model InviteToken {
  id         String    @id @default(uuid())
  token      String    @unique @default(uuid())
  email      String
  role       Role      @default(VIEWER)
  isUsed     Boolean   @default(false)
  expiresAt  DateTime
  createdAt  DateTime  @default(now())

  tenantId   String
  tenant     Tenant    @relation(fields: [tenantId], references: [id])

  invitedById String?
  invitedBy   User?   @relation(fields: [invitedById], references: [id])

  @@index([token])
  @@index([tenantId])
}

model PasswordResetToken {
  id        String   @id @default(uuid())
  token     String   @unique
  email     String
  isUsed    Boolean   @default(false) 
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime @default(now())


  @@map("password_reset_tokens")
}

// ─── ONE TIME LINK ───────────────────────────────────────────────────────────
model OneTimeLink {
  id         String    @id @default(uuid())
  token      String    @unique @default(uuid())
  isUsed     Boolean   @default(false)
  expiresAt  DateTime
  createdAt  DateTime  @default(now())

  tenantId   String
  tenant     Tenant    @relation(fields: [tenantId], references: [id])

  fileId     String
  file       File      @relation(fields: [fileId], references: [id])

  @@index([token])
}

// ─── FILE METADATA ────────────────────────────────────────────────────────────
model FileMetadata {
  id        String   @id @default(uuid())
  key       String
  value     String
  fileId    String
  file      File     @relation(fields: [fileId], references: [id])
  createdAt DateTime @default(now())

@@map("file_metadata")
  @@index([fileId])
}

model FileComment {
  id        String   @id @default(uuid())
  content   String
  fileId    String
  file      File     @relation(fields: [fileId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([fileId])
}

// ─── AUDIT LOG ────────────────────────────────────────────────────────────────
model AuditLog {
  id           String   @id @default(uuid())
  action       String   // file.upload | file.delete | file.download | folder.create | permission.grant | user.invite etc
  resourceType String?  // file | folder | user | permission
  resourceId   String?  // ID of the affected resource
  resourceName String?  // human readable name
  metadata     Json?    // extra info like old/new values
  ipAddress    String?
  userAgent    String?
  createdAt    DateTime @default(now())

  userId       String?
  user         User?    @relation(fields: [userId], references: [id])

  tenantId     String
  tenant       Tenant   @relation(fields: [tenantId], references: [id])

  @@index([tenantId])
  @@index([tenantId, createdAt])
  @@index([userId])
  @@index([action])
}

// ─── GUEST ACCESS (external share with granular permissions) ──────────────────
model GuestAccess {
  id           String    @id @default(uuid())
  token        String    @unique @default(uuid())
  email        String
  label        String?

  resourceType String
  resourceId   String

  capabilities Json?

  isRevoked    Boolean   @default(false)
  expiresAt    DateTime
  createdAt    DateTime  @default(now())

  tenantId     String
  tenant       Tenant    @relation(fields: [tenantId], references: [id])

  fileId       String?
  file         File?     @relation("GuestAccessFile", fields: [fileId], references: [id])

  @@index([token])
  @@index([tenantId])
  @@index([fileId])
  @@map("guest_access")
}

// ─── METADATA TEMPLATES (Admin-defined) ───────────────────────────────────────
model MetadataTemplate {
  id          String   @id @default(uuid())
  name        String
  description String?
  tenantId    String
  tenant      Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  fields      MetadataTemplateField[]
  createdAt   DateTime @default(now())

  @@index([tenantId])
  @@map("metadata_templates")
}

model MetadataTemplateField {
  id         String   @id @default(uuid())
  key        String   // e.g. "Invoice Number", "Due Date"
  type       String   @default("text") // "text", "date", "number"
  required   Boolean  @default(false)
  templateId String
  template   MetadataTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)

  @@index([templateId])
  @@map("metadata_template_fields")
}

// ─── PER-FOLDER METADATA DEFAULT FIELDS (FolderIT parity) ────────────────────
// Defines the default metadata schema for files inside a given folder.
// If `recursive` is true, the field definition is also applied to descendant
// folders for required-value checks and metadata editor rendering.

model FolderMetadataField {
  id        String   @id @default(uuid())
  tenantId  String
  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  folderId  String
  folder    Folder   @relation(fields: [folderId], references: [id], onDelete: Cascade)

  key       String
  type      String   @default("text") // "text", "boolean", "date", "datetime", "number", ...
  required  Boolean  @default(false)
  recursive Boolean  @default(false)
  options   Json    @default("[]")
  createdAt DateTime @default(now())

  @@index([tenantId, folderId])
  @@index([tenantId, key])
  @@map("folder_metadata_fields")
}