# ===============================
# DATABASE
# ===============================
DATABASE_URL="postgresql://postgres:password@localhost:5432/folderit"

# ===============================
# API
# ===============================
PORT=5000
NODE_ENV=development
FRONTEND_URL=http://localhost:5173

# ===============================
# AUTH
# ===============================
JWT_SECRET=your_jwt_secret_here
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# ===============================
# STORAGE (Cloudflare R2)
# ===============================
R2_ACCOUNT_ID=your_account_id
R2_ACCESS_KEY_ID=your_access_key
R2_SECRET_ACCESS_KEY=your_secret_key
R2_BUCKET_NAME=your_bucket_name
R2_PUBLIC_URL=https://your-public-url

# ===============================
# RAZORPAY (optional)
# ===============================
BILLING_MOCK_MODE=false
RAZORPAY_KEY_ID=rzp_test_xxxx
RAZORPAY_KEY_SECRET=your_key_secret
RAZORPAY_WEBHOOK_SECRET=your_webhook_secret

# ===============================
# EMAIL (SendGrid)
# ===============================
SENDGRID_API_KEY=your_sendgrid_api_key
FROM_EMAIL=noreply@yourapp.com

# ===============================
# APP
# ===============================
APP_URL=http://localhost:5173

RAZORPAY_PLAN_MINI=plan_SWYQXObqUYEAqK
RAZORPAY_PLAN_MEDIUM=plan_SWYSNt6a19iGuw
RAZORPAY_PLAN_TAILOR=plan_xxxxx
